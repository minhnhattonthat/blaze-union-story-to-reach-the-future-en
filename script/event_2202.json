  "bytes": 23,
  "kind": "msg",
  "slots": [
   10418
  ],
  "jp": "{voice:008817}頭が固いですね……",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00BF7",
  "ptr": 3063,
  "bytes": 56,
  "kind": "msg",
  "slots": [
   10436
  ],
  "jp": "{voice:008917}とにかくこれ以上の足止めは{n}無用だ。先を急ぐのでな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00C2F",
