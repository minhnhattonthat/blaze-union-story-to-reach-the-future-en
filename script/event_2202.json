[
 {
  "id": "event_2202_00028",
  "ptr": 40,
  "bytes": 61,
  "kind": "msg",
  "slots": [
   4399
  ],
  "jp": "{voice:005417}だからー！{n}王国の王様が来ても{n}入れちゃダメなんだってば②",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00065",
  "ptr": 101,
  "bytes": 50,
  "kind": "msg",
  "slots": [
   4417
  ],
  "jp": "{voice:005517}何故拙者がお主らの命令に{n}従わねばならぬのか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00097",
  "ptr": 151,
  "bytes": 81,
  "kind": "msg",
  "slots": [
   4424
  ],
  "jp": "{voice:005617}拙者は陛下より、城外の守備と{n}オルディーン国王の案内を{n}申し付かっておるのだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_000E8",
  "ptr": 232,
  "bytes": 38,
  "kind": "msg",
  "slots": [
   4485
  ],
  "jp": "{voice:005717}バルドゥス。{n}私の頼みでもダメか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0010E",
  "ptr": 270,
  "bytes": 91,
  "kind": "msg",
  "slots": [
   4503
  ],
  "jp": "{voice:005817}……申し訳ありません。{n}ラピス殿が来ても話を聞かぬよう、{n}そう申し送りがございましてな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00169",
  "ptr": 361,
  "bytes": 15,
  "kind": "msg",
  "slots": [
   4521
  ],
  "jp": "{voice:005917}そうか……",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00178",
  "ptr": 376,
  "bytes": 71,
  "kind": "msg",
  "slots": [
   4887
  ],
  "jp": "{voice:005A17}ダメだね、鉄壁だよ。{n}さすがブロンキアの盾と{n}呼ばれるだけはあるね。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_001BF",
  "ptr": 447,
  "bytes": 89,
  "kind": "msg",
  "slots": [
   4905
  ],
  "jp": "{voice:005B17}うーん…、もういっそのことさ、{n}強硬突破しちゃおうよ。{n}あの爺さんには前に勝ってるし。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00218",
  "ptr": 536,
  "bytes": 87,
  "kind": "msg",
  "slots": [
   4923
  ],
  "jp": "{voice:005C17}あの時の模擬戦とは違うぞ。{n}要塞の周りには数多くの{n}部隊がいる。正面突破は不可能だ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0026F",
  "ptr": 623,
  "bytes": 87,
  "kind": "msg",
  "slots": [
   4941
  ],
  "jp": "{voice:005D17}確かに危機的状況ではあるが、{n}まだオルディーン国王は、{n}イシュナートに入っていない。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_002C6",
  "ptr": 710,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   4948
  ],
  "jp": "{voice:005E17}帝国側がダメなら、{n}王国側に呼びかけるのだ。{n}イシュナートは危険だ、と。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00311",
  "ptr": 785,
  "bytes": 31,
  "kind": "msg",
  "slots": [
   5109
  ],
  "jp": "{voice:005F17}そう上手くいけばいいけど…",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00330",
  "ptr": 816,
  "bytes": 31,
  "kind": "msg",
  "slots": [
   5127
  ],
  "jp": "{voice:006017}メデューテ、周囲の状況は？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0034F",
  "ptr": 847,
  "bytes": 58,
  "kind": "msg",
  "slots": [
   5145
  ],
  "jp": "{voice:006117}それが、いくつもの部隊が{n}密かに配備されているようだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00389",
  "ptr": 905,
  "bytes": 65,
  "kind": "msg",
  "slots": [
   5152
  ],
  "jp": "{voice:006217}ここカノッサ街道は、{n}王国と帝国の国境線を横切る{n}一番の近道。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_003CA",
  "ptr": 970,
  "bytes": 52,
  "kind": "msg",
  "slots": [
   5170
  ],
  "jp": "{voice:006317}イシュナートに入城する国王は{n}必ずここを通る……",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_003FE",
  "ptr": 1022,
  "bytes": 48,
  "kind": "msg",
  "slots": [
   5188
  ],
  "jp": "{voice:006417}暗殺者が手ぐすね引いて{n}待っているって事か。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0042E",
  "ptr": 1070,
  "bytes": 42,
  "kind": "msg",
  "slots": [
   5206
  ],
  "jp": "{voice:006517}先ずはそれらを{n}排除せねばならないな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00458",
  "ptr": 1112,
  "bytes": 79,
  "kind": "msg",
  "slots": [
   5213
  ],
  "jp": "{voice:006617}そして入城前の国王と接触し、{n}暗殺者の存在を引き合いに出して、{n}交渉を行う。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_004A7",
  "ptr": 1191,
  "bytes": 54,
  "kind": "msg",
  "slots": [
   5231
  ],
  "jp": "{voice:006717}なんとか要塞に入る前に、{n}国王を止める作戦ですね。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_004DD",
  "ptr": 1245,
  "bytes": 31,
  "kind": "msg",
  "slots": [
   5307
  ],
  "jp": "{voice:006817}それで、本当に大丈夫かな？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_004FC",
  "ptr": 1276,
  "bytes": 79,
  "kind": "msg",
  "slots": [
   5314
  ],
  "jp": "{voice:006917}私、うまく言えないけどさ、{n}あの要塞から、嫌ーな感じが{n}伝わってくるのよね。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0054B",
  "ptr": 1355,
  "bytes": 60,
  "kind": "msg",
  "slots": [
   5321
  ],
  "jp": "{voice:006A17}万一に備えて、要塞の中にも兵を{n}配置すべきじゃないかな？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00587",
  "ptr": 1415,
  "bytes": 73,
  "kind": "msg",
  "slots": [
   5328
  ],
  "jp": "{voice:006B17}だってさ、国王が城内に{n}入っちゃったら、私達手が{n}出せなくなるんだよ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_005D0",
  "ptr": 1488,
  "bytes": 31,
  "kind": "msg",
  "slots": [
   5346
  ],
  "jp": "{voice:006C17}そうだけど、危険すぎるよ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_005EF",
  "ptr": 1519,
  "bytes": 54,
  "kind": "msg",
  "slots": [
   5364
  ],
  "jp": "{voice:006D17}俺はシスキアの案に賛成だ。{n}備えはあった方がいい。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00625",
  "ptr": 1573,
  "bytes": 69,
  "kind": "msg",
  "slots": [
   5382
  ],
  "jp": "{voice:006E17}分かった、こうしよう。{n}僕とシスキアの部隊で、要塞内に{n}潜入する。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0066A",
  "ptr": 1642,
  "bytes": 46,
  "kind": "msg",
  "slots": [
   5400
  ],
  "jp": "{voice:006F17}ジェノンが？{n}足、引っ張らなきゃいいけど…",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00698",
  "ptr": 1688,
  "bytes": 83,
  "kind": "msg",
  "slots": [
   5418
  ],
  "jp": "{voice:007017}何かあったら報告しろ。{n}それから危険を感じたら逃げろ。{n}その２つは守れ、いいな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_006EB",
  "ptr": 1771,
  "bytes": 21,
  "kind": "msg",
  "slots": [
   5436
  ],
  "jp": "{voice:007117}うん、了解だよ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00700",
  "ptr": 1792,
  "bytes": 50,
  "kind": "msg",
  "slots": [
   5523
  ],
  "jp": "{voice:007217}じゃあ俺達は暗殺者を{n}見つけ出して始末しよう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00732",
  "ptr": 1842,
  "bytes": 54,
  "kind": "msg",
  "slots": [
   5800
  ],
  "jp": "{voice:007317}部隊をなるべく散らし、{n}捜索範囲を広めに取るんだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00768",
  "ptr": 1896,
  "bytes": 77,
  "kind": "msg",
  "slots": [
   5818
  ],
  "jp": "{voice:007417}暗殺者を見つけたら、各個撃破。{n}他部隊は、可能なら助勢に入る。{n}いいわね？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_007B5",
  "ptr": 1973,
  "bytes": 37,
  "kind": "msg",
  "slots": [
   9279
  ],
  "jp": "{voice:007517}これで暗殺者の討伐は終わったな…",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_007DA",
  "ptr": 2010,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   9286
  ],
  "jp": "{voice:007617}あとはこの街道を{n}国王が通るのを待って、{n}要塞入りを止めればいいだろう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00825",
  "ptr": 2085,
  "bytes": 11,
  "kind": "msg",
  "slots": [
   9686
  ],
  "jp": "……………",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00830",
  "ptr": 2096,
  "bytes": 50,
  "kind": "msg",
  "slots": [
   9853
  ],
  "jp": "{voice:007717}オルディーン国王、{n}我々の話をお聞きください。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00862",
  "ptr": 2146,
  "bytes": 13,
  "kind": "msg",
  "slots": [
   9871
  ],
  "jp": "{voice:007817}何者だ？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_0086F",
  "ptr": 2159,
  "bytes": 77,
  "kind": "msg",
  "slots": [
   10100
  ],
  "jp": "{voice:007917}私は、ブロンキア帝国の{n}商業都市ティエラの方伯で、{n}ヴェルマンと申します。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_008BC",
  "ptr": 2236,
  "bytes": 73,
  "kind": "msg",
  "slots": [
   10107
  ],
  "jp": "{voice:007A17}単刀直入に申し上げます。{n}イシュナート要塞に、不穏な動き{n}があります。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00905",
  "ptr": 2309,
  "bytes": 48,
  "kind": "msg",
  "slots": [
   10114
  ],
  "jp": "{voice:007B17}今すぐ王国へと、{n}お戻り頂けないでしょうか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00935",
  "ptr": 2357,
  "bytes": 13,
  "kind": "msg",
  "slots": [
   10132
  ],
  "jp": "{voice:007C17}…断る。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00942",
  "ptr": 2370,
  "bytes": 31,
  "kind": "msg",
  "slots": [
   10150
  ],
  "jp": "{voice:007D17}断るとおっしゃいましたか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00961",
  "ptr": 2401,
  "bytes": 83,
  "kind": "msg",
  "slots": [
   10168
  ],
  "jp": "{voice:007E17}そうだ。一国の皇帝に対し、{n}約束を反故にする事は、{n}国として信義にもとる行為だ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_009B4",
  "ptr": 2484,
  "bytes": 64,
  "kind": "msg",
  "slots": [
   10175
  ],
  "jp": "{voice:007F17}そのような情報に踊らされるほど、{n}私は愚かではないつもりだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_009F4",
  "ptr": 2548,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   10237
  ],
  "jp": "{voice:008017}しかし、我々は既に{n}城外に控えていた暗殺部隊を{n}何名も討っているのです。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00A3F",
  "ptr": 2623,
  "bytes": 73,
  "kind": "msg",
  "slots": [
   10244
  ],
  "jp": "{voice:008117}位置と場所から考えて、{n}オルディーン陛下を狙っていた{n}のは明らかです。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00A88",
  "ptr": 2696,
  "bytes": 73,
  "kind": "msg",
  "slots": [
   10262
  ],
  "jp": "{voice:008217}言いたい事はわかった。{n}しかし、それだけの情報では{n}戻る訳にはいかん。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00AD1",
  "ptr": 2769,
  "bytes": 89,
  "kind": "msg",
  "slots": [
   10269
  ],
  "jp": "{voice:008317}君達が何故私を守ろうとするのか、{n}それはわからぬが、{n}単純に礼は言っておく。恩に着る。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00B2A",
  "ptr": 2858,
  "bytes": 50,
  "kind": "msg",
  "slots": [
   10287
  ],
  "jp": "{voice:008417}…人の言う事は、{n}素直に聞いたらどうなのです。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00B5C",
  "ptr": 2908,
  "bytes": 23,
  "kind": "msg",
  "slots": [
   10357
  ],
  "jp": "{voice:008517}ん？　似ておるな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00B73",
