  "bytes": 42,
  "kind": "msg",
  "slots": [
   10393
  ],
  "jp": "{voice:008617}いや、すまない。{n}他人のそら似だろう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00BA8",
  "ptr": 2984,
  "bytes": 56,
  "kind": "msg",
  "slots": [
   10400
  ],
  "jp": "{voice:008717}さて、そろそろ行かねばならぬ。{n}そこをどいて貰おう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2202_00BE0",
