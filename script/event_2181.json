  "status": ""
 },
 {
  "id": "event_2181_0083F",
  "ptr": 2111,
  "bytes": 58,
  "kind": "msg",
  "slots": [
   8957
  ],
  "jp": "{voice:00BD0C}よし、演習を開始せよ。{n}まずはヴェルマンの私兵からだ。",
