  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_007D7",
  "ptr": 2007,
  "bytes": 91,
  "kind": "msg",
  "slots": [
   8915
  ],
  "jp": "{voice:00BB0C}ヴェルマンもそうだが、{n}どうも奴らは近い将来、俺の前に{n}立ちはだかるような気がするのだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00832",
  "ptr": 2098,
  "bytes": 13,
  "kind": "msg",
  "slots": [
   8936
  ],
  "jp": "{voice:00BC0C}陛下……",
