[
 {
  "id": "event_2181_00028",
  "ptr": 40,
  "bytes": 81,
  "kind": "msg",
  "slots": [
   7475
  ],
  "jp": "{voice:009B0C}あれが帝国の正規軍か。{n}レオンの辺境部隊を除けば、{n}間近で見るのは初めてだね。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00079",
  "ptr": 121,
  "bytes": 56,
  "kind": "msg",
  "slots": [
   7496
  ],
  "jp": "{voice:009C0C}整然とした隊列だ。{n}やはり賊まがいの連中とは違うな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_000B1",
  "ptr": 177,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   7517
  ],
  "jp": "{voice:009D0C}見てみろ、ガーロット。{n}帝国一精強な鋼鉄騎団を率いる{n}バルドゥス将軍だ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_000FC",
  "ptr": 252,
  "bytes": 11,
  "kind": "msg",
  "slots": [
   7581
  ],
  "jp": "……………",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00107",
  "ptr": 263,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   7622
  ],
  "jp": "{voice:009E0C}あれが軍神バルドゥス……{n}名前は聞いた事があるけど、{n}見るのは初めてだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00152",
  "ptr": 338,
  "bytes": 77,
  "kind": "msg",
  "slots": [
   7643
  ],
  "jp": "{voice:009F0C}長い間、帝国の軍を支え{n}『軍神』と渾名される…{n}いわば軍の頂点に立つ男だ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0019F",
  "ptr": 415,
  "bytes": 58,
  "kind": "msg",
  "slots": [
   7664
  ],
  "jp": "{voice:00A00C}でも本当にお爺ちゃんね。{n}騎馬隊の指揮なんかできるの？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_001D9",
  "ptr": 473,
  "bytes": 77,
  "kind": "msg",
  "slots": [
   7685
  ],
  "jp": "{voice:00A10C}戦場を駆け回って戦い続け、{n}叩き上げであの地位を得た男だ。{n}決して侮るな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00226",
  "ptr": 550,
  "bytes": 65,
  "kind": "msg",
  "slots": [
   7733
  ],
  "jp": "{voice:00A20C}…ヴェルマン方伯。{n}この演習は何か裏があると{n}思っていますか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00267",
  "ptr": 615,
  "bytes": 62,
  "kind": "msg",
  "slots": [
   7754
  ],
  "jp": "{voice:00A30C}ああ、恐らくは貴族が持つ力を{n}計ろうというお考えであろう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_002A5",
  "ptr": 677,
  "bytes": 56,
  "kind": "msg",
  "slots": [
   7761
  ],
  "jp": "{voice:00A40C}我々が力を持ち過ぎる事を{n}陛下は警戒されているのだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_002DD",
  "ptr": 733,
  "bytes": 67,
  "kind": "msg",
  "slots": [
   7768
  ],
  "jp": "{voice:00A50C}過小な評価を受け、{n}ソルティエ帝の警戒心が{n}和らげばよいのだが…",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00320",
  "ptr": 800,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   7789
  ],
  "jp": "{voice:00A60C}手を抜け、って事か？{n}それは相手の力量と戦い方次第だ。{n}今回は難しいぜ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0036B",
  "ptr": 875,
  "bytes": 50,
  "kind": "msg",
  "slots": [
   7810
  ],
  "jp": "{voice:00A70C}…そうであろうな。{n}相手はあの軍神なのだから。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0039D",
  "ptr": 925,
  "bytes": 60,
  "kind": "msg",
  "slots": [
   7902
  ],
  "jp": "{voice:00A80C}貴族の私兵が相手とは…{n}我が鋼鉄騎団の調練になるものか。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_003D9",
  "ptr": 985,
  "bytes": 40,
  "kind": "msg",
  "slots": [
   8156
  ],
  "jp": "{voice:00A90C}これは陛下。{n}いかがなされましたか？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00401",
  "ptr": 1025,
  "bytes": 44,
  "kind": "msg",
  "slots": [
   8177
  ],
  "jp": "{voice:00AA0C}バルドゥスよ。{n}貴族の私兵共をどう見る？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0042D",
  "ptr": 1069,
  "bytes": 56,
  "kind": "msg",
  "slots": [
   8198
  ],
  "jp": "{voice:00AB0C}はっきりと申し上げれば、{n}…寄せ集めでございますな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00465",
  "ptr": 1125,
  "bytes": 62,
  "kind": "msg",
  "slots": [
   8219
  ],
  "jp": "{voice:00AC0C}ヴェルマンの私兵はどうだ？{n}巷を騒がせるグラムブレイズだ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_004A3",
  "ptr": 1187,
  "bytes": 60,
  "kind": "msg",
  "slots": [
   8304
  ],
  "jp": "{voice:00AD0C}あの赤髪の若武者達とは、{n}一度剣を交えた事がございます。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_004DF",
  "ptr": 1247,
  "bytes": 40,
  "kind": "msg",
  "slots": [
   8325
  ],
  "jp": "{voice:00AE0C}そうだな。{n}一度お前を破った連中だ。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00507",
  "ptr": 1287,
  "bytes": 62,
  "kind": "msg",
  "slots": [
   8346
  ],
  "jp": "{voice:00AF0C}あの時は、失礼ながら余興と存じ、{n}実力は出しておりません。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00545",
  "ptr": 1349,
  "bytes": 37,
  "kind": "msg",
  "slots": [
   8375
  ],
  "jp": "{voice:00B00C}…あの赤髪の若武者が団長ですな。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0056A",
  "ptr": 1386,
  "bytes": 52,
  "kind": "msg",
  "slots": [
   8382
  ],
  "jp": "{voice:00B10C}他に比べれば、{n}いくらかマシという程度でしょう。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_0059E",
  "ptr": 1438,
  "bytes": 75,
  "kind": "msg",
  "slots": [
   8403
  ],
  "jp": "{voice:00B20C}部隊の強弱は、実際に{n}ぶつかってみなければわからない。{n}違うか、軍神よ？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_005E9",
  "ptr": 1513,
  "bytes": 25,
  "kind": "msg",
  "slots": [
   8424
  ],
  "jp": "{voice:00B30C}…御意にございます。",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00602",
  "ptr": 1538,
  "bytes": 55,
  "kind": "msg",
  "slots": [
   8488
  ],
  "jp": "{voice:00B40C}まあよい。{n}奴らの真の力を引き出し、計れ。{n}よいな？",
  "en": "",
  "status": ""
 },
 {
  "id": "event_2181_00639",
